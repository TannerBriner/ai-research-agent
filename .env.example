# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# Get one at https://tavily.com/ (free tier: 1000 searches/month, no credit card)
TAVILY_API_KEY=your-tavily-key-here

# Optional: override the default model. Check current model IDs at
# https://docs.anthropic.com/en/docs/about-claude/models before running,
# since the default below may be out of date by the time you read this.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
